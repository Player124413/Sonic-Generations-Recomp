{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Clang, Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux Clang Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-vulkan",
            "displayName": "Linux Clang Vulkan runtime",
            "inherits": "linux-clang",
            "binaryDir": "${sourceDir}/build/linux-vulkan",
            "cacheVariables": {
                "SONIC_GENERATIONS_ENABLE_VULKAN": "ON"
            }
        },
        {
            "name": "windows-clang",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "toolset": "ClangCL",
            "binaryDir": "${sourceDir}/build/windows-clang",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "CMAKE_BUILD_TYPE": "Release",
                "SONIC_GENERATIONS_ENABLE_VULKAN": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "linux-clang",
            "configurePreset": "linux-clang"
        },
        {
            "name": "linux-vulkan",
            "configurePreset": "linux-vulkan"
        },
        {
            "name": "windows-clang",
            "configurePreset": "windows-clang",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-vulkan",
            "configurePreset": "linux-vulkan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-clang",
            "configurePreset": "windows-clang",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
