 #if !defined(__cplusplus) || defined(__INTELLISENSE__)
 
+// Full hardware boolean register bank for constants absent from reflection.
+// Host must upload 256 bits (32 bytes), with the hardware register numbering.
+// This is an additional binding, NOT the legacy packed g_Booleans word.
+cbuffer GenerationsBoolConstants : register(b3, space4)
+{
+    uint4 g_GenerationsBoolWords[2];
+};
+uint GenerationsReadBool(uint index)
+{
+    return (g_GenerationsBoolWords[index / 128][(index / 32) % 4] >> (index % 32)) & 1u;
+}
